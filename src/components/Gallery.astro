---
import { rustImages } from '../data/rust';
import { getUi } from '../data/i18n';
import { getGalleryUi } from '../data/i18n/gallery-ui';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import {
	contentSrc,
	contentSrcSet,
	galleryTileSizes,
} from '../lib/responsive-images';

interface Props {
	locale?: LocaleCode;
	/** Homepage gallery sits below the hero — never compete for LCP. */
	priority?: boolean;
}

const locale = Astro.props.locale ?? defaultLocale;
const priority = Astro.props.priority ?? false;
const ui = getUi(locale);
const gallery = getGalleryUi(locale);

// Featured media = full gameplay video. Grid stills below; large filler still under grid.
const galleryAlts = [
	ui.images.squadFight,
	ui.images.cheatsPackage,
	ui.images.battleRoyaleIsland,
	ui.images.headerArt,
	ui.images.espWallhack,
	ui.images.rebootFight,
	undefined,
] as const;

/** Featured still — first gallery image. */
const featuredStillSrc = rustImages.gallery[0].src;
const featuredStill = {
	src: contentSrc(featuredStillSrc),
	srcset: contentSrcSet(featuredStillSrc),
	alt: rustImages.gallery[0].alt,
} as const;

/** Grid uses images 2–7 — all seven assets appear once on the page. */
const gridTiles = rustImages.gallery.slice(1).map((image, index) => ({
	src: contentSrc(image.src),
	srcset: contentSrcSet(image.src),
	alt: galleryAlts[index + 1] ?? image.alt,
}));
---

<section class="gallery" id="gallery" aria-labelledby="gallery-title">
	<header class="gallery__head">
		<p class="gallery__eyebrow">{gallery.eyebrow}</p>
		<h2 id="gallery-title" class="gallery__title">{gallery.title}</h2>
		<p class="gallery__sub">{gallery.subtitle}</p>
	</header>

	<div class="gallery__layout">
		<div class="gallery__content">
			<div class="gallery__summary">
				<p class="gallery__lead">{gallery.lead}</p>

				<div class="gallery__highlights">
					{
						gallery.highlights.map((item) => (
							<article class="gallery__info-card">
								<h3>{item.title}</h3>
								<p>{item.copy}</p>
							</article>
						))
					}
				</div>

				<aside class="gallery__advantages" aria-labelledby="gallery-advantages-title">
					<h3 id="gallery-advantages-title" class="gallery__advantages-label">Overwatch hack advantages</h3>
					<ul class="gallery__advantages-list">
						<li>Undetected-focused builds with public anti-cheat status after patches</li>
						<li>Full Overwatch ESP + soft aim + radar in one package — no feature upsell maze</li>
						<li>Instant license delivery for Windows 10 &amp; 11</li>
						<li>Real in-game Overwatch previews so you see ESP, aimbot menu, and wallhack before checkout</li>
					</ul>
				</aside>
			</div>

			<div class="gallery__media">
				<figure class="gallery__featured gallery__still media-frame">
					<img
						src={featuredStill.src}
						srcset={featuredStill.srcset}
						sizes="(max-width: 560px) 100vw, (max-width: 900px) 100vw, 52vw"
						alt={featuredStill.alt}
						width="1280"
						height="720"
						loading={priority ? 'eager' : 'lazy'}
						fetchpriority={priority ? 'high' : 'auto'}
						decoding="async"
					/>
					<figcaption>{featuredStill.alt}</figcaption>
				</figure>

				<div class="gallery__grid">
					{
						gridTiles.map((image) => (
							<figure class="gallery__item media-frame">
								<img
									src={image.src}
									srcset={image.srcset}
									sizes={galleryTileSizes}
									alt={image.alt}
									width="1280"
									height="720"
									loading="lazy"
									decoding="async"
								/>
								<figcaption>{image.alt}</figcaption>
							</figure>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.gallery {
		width: 100%;
		content-visibility: auto;
		contain-intrinsic-size: 1px 900px;
	}

	.gallery__head {
		margin-bottom: 1.25rem;
	}

	.gallery__eyebrow {
		margin: 0 0 0.4rem;
		font-size: 0.75rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-orchid);
	}

	.gallery__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.6rem, 3vw, 2.2rem);
		font-weight: 800;
		letter-spacing: -0.03em;
	}

	.gallery__sub {
		margin: 0.55rem 0 0;
		color: var(--color-muted);
		max-width: 36rem;
		line-height: 1.55;
	}

	.gallery__layout {
		border: 1px solid rgba(168, 85, 247, 0.12);
		border-radius: 1.1rem;
		background: rgba(18, 16, 26, 0.46);
		overflow: hidden;
	}

	.gallery__content {
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.35fr);
		align-items: stretch;
		gap: 1rem;
		padding: 1rem;
	}

	.gallery__summary {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		align-self: stretch;
		min-height: 0;
	}

	.gallery__lead {
		margin: 0;
		padding: 1rem 1.05rem;
		border-radius: 0.95rem;
		border: 1px solid rgba(168, 85, 247, 0.14);
		background: rgba(26, 22, 38, 0.72);
		color: #e2d9ef;
		line-height: 1.7;
	}

	.gallery__highlights {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		min-height: 0;
		flex: 1 1 auto;
	}

	.gallery__info-card {
		padding: 0.95rem 1rem;
		border-radius: 0.9rem;
		border: 1px solid rgba(168, 85, 247, 0.14);
		background: rgba(10, 6, 18, 0.34);
	}

	.gallery__advantages {
		margin-top: auto;
		padding: 1rem 1.05rem;
		border-radius: 0.95rem;
		border: 1px solid rgba(192, 132, 252, 0.28);
		background:
			linear-gradient(145deg, rgba(124, 58, 237, 0.18), transparent 55%),
			rgba(26, 22, 38, 0.88);
	}

	.gallery__advantages-label {
		margin: 0 0 0.65rem;
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--color-orchid);
	}

	.gallery__advantages-list {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.55rem;
	}

	.gallery__advantages-list li {
		position: relative;
		padding-left: 1.05rem;
		color: #e2d9ef;
		font-size: 0.9rem;
		line-height: 1.55;
		font-weight: 600;
	}

	.gallery__advantages-list li::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.45em;
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 999px;
		background: var(--color-violet);
		box-shadow: 0 0 10px rgba(168, 85, 247, 0.55);
	}

	.gallery__info-card h3 {
		margin: 0;
		font-size: 0.98rem;
		font-weight: 750;
		color: var(--color-ink);
	}

	.gallery__info-card p {
		margin: 0.45rem 0 0;
		color: var(--color-muted);
		font-size: 0.92rem;
		line-height: 1.6;
	}

	.gallery__media {
		display: grid;
		gap: 0.45rem;
		grid-template-rows: auto auto;
		align-self: stretch;
		min-height: 100%;
	}

	.gallery__featured,
	.gallery__video,
	.gallery__still,
	.gallery__item {
		margin: 0;
	}

	.gallery__featured,
	.gallery__video {
		aspect-ratio: 16 / 9;
		border: 1px solid rgba(192, 132, 252, 0.22);
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.26);
	}

	.gallery__still {
		min-height: 11rem;
		height: 100%;
		border: 1px solid rgba(192, 132, 252, 0.22);
		box-shadow: 0 12px 28px rgba(0, 0, 0, 0.26);
	}

	.gallery__video video {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		background: #0a0612;
	}

	@media (prefers-reduced-motion: reduce) {
		.gallery__video {
			display: none;
		}
	}

	.gallery__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.45rem;
	}

	.gallery__item {
		aspect-ratio: 16 / 11;
	}

	.gallery__featured img,
	.gallery__still img,
	.gallery__item img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.45s ease;
	}

	.gallery__featured:hover img,
	.gallery__item:hover img {
		transform: scale(1.33);
	}

	@media (hover: none), (pointer: coarse) {
		.gallery__featured:hover img,
		.gallery__item:hover img {
			transform: none;
		}

		.gallery__featured figcaption,
		.gallery__still figcaption,
		.gallery__item figcaption {
			opacity: 1;
			transform: none;
		}
	}

	.gallery__featured figcaption,
	.gallery__video figcaption,
	.gallery__still figcaption,
	.gallery__item figcaption {
		position: absolute;
		inset: auto 0 0;
		z-index: 2;
		padding: 1.6rem 0.95rem 0.8rem;
		background: linear-gradient(transparent, rgba(10, 6, 18, 0.92));
		color: #ddd4ec;
		font-size: 0.75rem;
		font-weight: 600;
		opacity: 0;
		transform: translateY(6px);
		transition:
			opacity 0.25s ease,
			transform 0.25s ease;
	}

	.gallery__featured:hover figcaption,
	.gallery__still:hover figcaption,
	.gallery__item:hover figcaption {
		opacity: 1;
		transform: translateY(0);
	}

	.gallery__video figcaption {
		opacity: 1;
		transform: none;
	}

	@media (max-width: 900px) {
		.gallery__content {
			grid-template-columns: 1fr;
			grid-template-rows: auto auto;
			align-items: start;
			gap: 0.85rem;
		}

		.gallery__summary {
			order: 0;
			width: 100%;
			height: auto;
		}

		.gallery__media {
			order: 1;
			width: 100%;
			margin-top: 0;
		}

		.gallery__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 560px) {
		.gallery__head {
			margin-bottom: 0.85rem;
		}

		.gallery__title {
			font-size: clamp(1.35rem, 5.5vw, 1.65rem);
		}

		.gallery__sub {
			font-size: 0.9rem;
		}

		.gallery__content {
			padding: 0.75rem;
			gap: 0.75rem;
		}

		.gallery__summary {
			gap: 0.65rem;
		}

		.gallery__highlights {
			gap: 0.65rem;
		}

		.gallery__lead {
			padding: 0.85rem;
			font-size: 0.92rem;
			line-height: 1.6;
		}

		.gallery__info-card {
			padding: 0.8rem 0.85rem;
		}

		.gallery__info-card h3 {
			font-size: 0.92rem;
		}

		.gallery__info-card p {
			font-size: 0.86rem;
		}

		.gallery__advantages {
			padding: 0.85rem;
		}

		.gallery__advantages-list li {
			font-size: 0.86rem;
		}

		.gallery__grid {
			grid-template-columns: 1fr;
			gap: 0.4rem;
		}

		.gallery__media {
			gap: 0.4rem;
		}

		.gallery__featured {
			aspect-ratio: 4 / 3;
		}

		.gallery__video {
			aspect-ratio: 16 / 9;
		}

		.gallery__media {
			grid-template-rows: auto auto auto;
		}

		.gallery__still {
			aspect-ratio: 16 / 10;
			min-height: 0;
			height: auto;
		}

		.gallery__featured figcaption,
		.gallery__video figcaption,
		.gallery__still figcaption,
		.gallery__item figcaption {
			opacity: 1;
			transform: none;
			font-size: 0.7rem;
			padding: 1.2rem 0.75rem 0.65rem;
		}
	}
</style>
