---
import { warframeImages, productPreviewVideo } from '../data/warframe';
import { getUi } from '../data/i18n';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { productInfo, siteConfig } from '../data/site';
import RelatedPages from './RelatedPages.astro';
import {
	contentSrc,
	contentSrcSet,
	productMainSizes,
	productThumbSizes,
} from '../lib/responsive-images';

interface Props {
	locale?: LocaleCode;
	showRelatedPages?: boolean;
}

const locale = Astro.props.locale ?? defaultLocale;
const showRelatedPages = Astro.props.showRelatedPages ?? true;
const ui = getUi(locale);

const monthlyPlan = productInfo.plans.find((plan) => plan.id === 'monthly') ?? productInfo.plans[0];
const lifetimePlan = productInfo.plans.find((plan) => plan.id === 'lifetime');
const defaultPlan = monthlyPlan;

const heroPreview = {
	src: contentSrc(warframeImages.hero),
	srcset: contentSrcSet(warframeImages.hero),
	alt: 'Warframe cheats gameplay preview — ESP and aimbot on PC',
};

const thumbImages = warframeImages.product.slice(0, 2).map((image) => ({
	src: contentSrc(image.src),
	srcset: contentSrcSet(image.src),
	alt: image.alt,
}));

const monthlyPerDay = (monthlyPlan.price / 30).toFixed(2);

const featurePills = [
	{ icon: 'bolt', label: ui.trust.delivery },
	{ icon: 'sliders', label: 'Easy to use' },
	{ icon: 'shield', label: 'Undetected' },
	{ icon: 'headset', label: '24/7 support' },
] as const;
---

<section
	class="pricing-showcase surface-card"
	id="pricing"
	data-product
	aria-label={ui.nav.pricing}
>
	<div class="pricing-showcase__media">
		<figure class="pricing-showcase__figure media-frame">
			<img
				src={heroPreview.src}
				srcset={heroPreview.srcset}
				sizes={productMainSizes}
				alt={heroPreview.alt}
				width="1280"
				height="720"
				class="pricing-showcase__image is-hidden"
				data-main-image
				loading="eager"
				fetchpriority="high"
				decoding="async"
			/>
			<div class="pricing-showcase__player" data-video-player>
				<video
					class="pricing-showcase__video"
					data-main-video
					src={productPreviewVideo.src}
					poster={productPreviewVideo.poster}
					preload="metadata"
					playsinline
					controls
					controlslist="nodownload noplaybackrate"
					disablepictureinpicture
					title={productPreviewVideo.title}
					aria-label={productPreviewVideo.ariaLabel}
				></video>
				<button
					type="button"
					class="pricing-showcase__play"
					data-video-play
					aria-label="Play Warframe cheats preview"
				>
					<span class="pricing-showcase__play-icon" aria-hidden="true">
						<svg width="28" height="28" viewBox="0 0 24 24" fill="none">
							<path
								d="M8 5.5v13l11-6.5-11-6.5z"
								fill="currentColor"
								stroke="currentColor"
								stroke-width="0.5"
								stroke-linejoin="round"></path>
						</svg>
					</span>
				</button>
			</div>
		</figure>
		<div class="pricing-showcase__thumbs" role="group" aria-label="Product preview images">
			<button
				type="button"
				class="pricing-showcase__thumb pricing-showcase__thumb--video is-active"
				aria-label="Show video preview"
				aria-pressed="true"
				data-thumb-video
			>
				<img
					src={contentSrc(warframeImages.hero)}
					srcset={contentSrcSet(warframeImages.hero)}
					sizes={productThumbSizes}
					alt="Video preview thumbnail"
					width="320"
					height="200"
					loading="lazy"
					decoding="async"
				/>
				<span class="pricing-showcase__thumb-play" aria-hidden="true">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
						<path d="M8 5.5v13l11-6.5-11-6.5z"></path>
					</svg>
				</span>
			</button>
			{
				thumbImages.map((image, index) => (
					<button
						type="button"
						class="pricing-showcase__thumb"
						aria-label={`Show ${image.alt}`}
						aria-pressed="false"
						data-thumb
						data-index={String(index)}
						data-src={image.src}
						data-srcset={image.srcset}
						data-alt={image.alt}
					>
						<img
							src={image.src}
							srcset={image.srcset}
							sizes={productThumbSizes}
							alt={image.alt}
							width="320"
							height="200"
							loading="lazy"
							decoding="async"
						/>
					</button>
				))
			}
		</div>
	</div>

	<div
		class="pricing-showcase__checkout"
		data-plan-selector
		data-default-plan={defaultPlan.id}
		data-buy-prefix={ui.product.addToCart}
		data-buy-show-price="false"
	>
		<div class="pricing-showcase__header">
			<h1 class="pricing-showcase__title">{productInfo.name}</h1>
			<span class="pricing-showcase__status">
				<span class="pricing-showcase__status-dot" aria-hidden="true"></span>
				Undetected
			</span>
		</div>

		<p class="pricing-showcase__social">
			<span class="pricing-showcase__social-dot" aria-hidden="true"></span>
			100+ others have purchased
		</p>

		<div class="pricing-showcase__plans" role="group" aria-label="Select a license plan">
			<button
				type="button"
				class="pricing-showcase__plan is-selected"
				data-plan={monthlyPlan.id}
				data-plan-label={ui.product.monthly}
				data-plan-price={monthlyPlan.price}
				data-checkout-url={siteConfig.checkoutUrl}
				aria-pressed="true"
			>
				<span class="pricing-showcase__plan-main">
					<span class="pricing-showcase__plan-name">{ui.product.monthly}</span>
					<span class="pricing-showcase__plan-price">${monthlyPlan.price}</span>
				</span>
				<span class="pricing-showcase__plan-sub">${monthlyPerDay}/day</span>
			</button>

			{
				lifetimePlan && (
					<button
						type="button"
						class="pricing-showcase__plan pricing-showcase__plan--featured"
						data-plan={lifetimePlan.id}
						data-plan-label={ui.product.lifetime}
						data-plan-price={lifetimePlan.price}
						data-checkout-url={siteConfig.checkoutUrl}
						aria-pressed="false"
					>
						<span class="pricing-showcase__plan-badge">
							<svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d="M12 3l2.2 4.5 5 .7-3.6 3.5.9 5.1L12 14.8 7.5 16.8l.9-5.1L4.8 8.2l5-.7L12 3z"></path>
							</svg>
							Most popular
						</span>
						<span class="pricing-showcase__plan-main">
							<span class="pricing-showcase__plan-name">{ui.product.lifetime}</span>
							<span class="pricing-showcase__plan-price">${lifetimePlan.price}</span>
						</span>
						<span class="pricing-showcase__plan-sub">One-time payment</span>
					</button>
				)
			}
		</div>

		<a
			href={siteConfig.checkoutUrl}
			class="pricing-showcase__cart btn-buy"
			data-plan-buy
			rel="noopener noreferrer"
		>
			<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path
					d="M6 6h15l-1.5 9h-12L4 3H2"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
				<circle cx="9" cy="20" r="1.25" fill="currentColor"></circle>
				<circle cx="18" cy="20" r="1.25" fill="currentColor"></circle>
			</svg>
			<span data-plan-buy-label>{ui.product.addToCart}</span>
		</a>

		<div class="pricing-showcase__pills" aria-label="Package highlights">
			{
				featurePills.map((pill) => (
					<span class="pricing-showcase__pill">
						<span class="pricing-showcase__pill-icon" data-icon={pill.icon} aria-hidden="true">
							{pill.icon === 'bolt' && (
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
									<path d="M13 3 5.5 13.5H12l-1 7.5L19.5 10H13l0-7Z" stroke-linejoin="round"></path>
								</svg>
							)}
							{pill.icon === 'sliders' && (
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
									<path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M4 14h0M12 12h0M20 16h0" stroke-linecap="round"></path>
								</svg>
							)}
							{pill.icon === 'shield' && (
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
									<path d="M12 3.5 5 6.5v5.2c0 4.2 2.9 7.8 7 8.8 4.1-1 7-4.6 7-8.8V6.5L12 3.5Z" stroke-linejoin="round"></path>
								</svg>
							)}
							{pill.icon === 'headset' && (
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
									<path d="M4 14v-2a8 8 0 0 1 16 0v2M4 14a2 2 0 0 0 2 2h1v-5H6a2 2 0 0 0-2 2Zm16 0a2 2 0 0 1-2 2h-1v-5h1a2 2 0 0 1 2 2Z" stroke-linecap="round"></path>
								</svg>
							)}
						</span>
						{pill.label}
					</span>
				))
			}
		</div>

		<div class="pricing-showcase__guarantee">
			<span class="pricing-showcase__guarantee-icon" aria-hidden="true">
				<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
					<path d="M12 3.5 5 6.5v5.2c0 4.2 2.9 7.8 7 8.8 4.1-1 7-4.6 7-8.8V6.5L12 3.5Z" stroke-linejoin="round"></path>
					<path d="m9.5 12 1.8 1.8 3.7-3.8" stroke-linecap="round" stroke-linejoin="round"></path>
				</svg>
			</span>
			<p>
				Your purchase is backed by years of development, continuous updates, and a dedicated support
				team committed to your success.
			</p>
		</div>

		{showRelatedPages && <RelatedPages locale={locale} />}
	</div>
</section>

<script>
	import { initPlanSelectors } from '../lib/plan-selector';
	initPlanSelectors();

	document.querySelectorAll('[data-product]').forEach((root) => {
		const videoThumb = root.querySelector('[data-thumb-video]');
		const imageThumbs = root.querySelectorAll('[data-thumb]');
		const videoPlayer = root.querySelector('[data-video-player]');
		const mainImage = root.querySelector('[data-main-image]');

		function showVideo() {
			videoPlayer?.classList.remove('is-hidden');
			mainImage?.classList.add('is-hidden');
			videoThumb?.classList.add('is-active');
			videoThumb?.setAttribute('aria-pressed', 'true');
			imageThumbs.forEach((thumb) => {
				thumb.classList.remove('is-active');
				thumb.setAttribute('aria-pressed', 'false');
			});
		}

		videoThumb?.addEventListener('click', showVideo);

		imageThumbs.forEach((thumb) => {
			thumb.addEventListener('click', () => {
				if (!(mainImage instanceof HTMLImageElement)) return;
				const src = thumb.getAttribute('data-src');
				const srcset = thumb.getAttribute('data-srcset');
				const alt = thumb.getAttribute('data-alt');
				if (src) mainImage.src = src;
				if (srcset) mainImage.srcset = srcset;
				if (alt) mainImage.alt = alt;
				videoPlayer?.classList.add('is-hidden');
				mainImage.classList.remove('is-hidden');
				videoThumb?.classList.remove('is-active');
				videoThumb?.setAttribute('aria-pressed', 'false');
				imageThumbs.forEach((item) => {
					const active = item === thumb;
					item.classList.toggle('is-active', active);
					item.setAttribute('aria-pressed', active ? 'true' : 'false');
				});
			});
		});
	});
</script>

<style>
	.pricing-showcase {
		display: grid;
		grid-template-columns: minmax(0, 1.08fr) minmax(0, 0.92fr);
		gap: clamp(1rem, 2vw, 1.5rem);
		align-items: center;
		width: 100%;
		margin: 0;
		padding: clamp(0.9rem, 1.8vw, 1.25rem);
		border-radius: var(--radius-card);
		border: 1px solid rgba(24, 217, 210, 0.18);
		background: linear-gradient(145deg, rgba(13, 34, 36, 0.96) 0%, rgba(8, 23, 25, 0.98) 100%);
		box-shadow:
			0 0 0 1px rgba(24, 217, 210, 0.05) inset,
			0 16px 40px rgba(0, 0, 0, 0.28);
	}

	.pricing-showcase__media {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		min-width: 0;
	}

	.pricing-showcase__figure {
		margin: 0;
		aspect-ratio: 16 / 10;
		border: 1px solid rgba(24, 217, 210, 0.35);
		border-radius: 0.85rem;
		box-shadow:
			0 0 0 1px rgba(24, 217, 210, 0.12),
			0 0 40px rgba(24, 217, 210, 0.18);
		overflow: hidden;
	}

	.pricing-showcase__player {
		position: absolute;
		inset: 0;
		z-index: 1;
		background: #050B0C;
	}

	.pricing-showcase__player.is-hidden {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.pricing-showcase__video,
	.pricing-showcase__image {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.pricing-showcase__image.is-hidden {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.pricing-showcase__play {
		position: absolute;
		inset: 0;
		z-index: 2;
		display: grid;
		place-items: center;
		margin: 0;
		padding: 0;
		border: 0;
		background: linear-gradient(180deg, rgba(5, 11, 12, 0.1), rgba(5, 11, 12, 0.45));
		color: #f8f4ff;
		cursor: pointer;
		transition: opacity 0.2s ease;
	}

	.pricing-showcase__play.is-hidden {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.pricing-showcase__play-icon {
		display: grid;
		place-items: center;
		width: 3.75rem;
		height: 3.75rem;
		border-radius: 999px;
		background: rgba(43, 119, 120, 0.92);
		box-shadow: 0 10px 28px rgba(0, 0, 0, 0.35);
	}

	.pricing-showcase__thumbs {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.65rem;
	}

	.pricing-showcase__thumb {
		position: relative;
		padding: 0;
		aspect-ratio: 16 / 10;
		border: 2px solid rgba(24, 217, 210, 0.2);
		border-radius: 0.65rem;
		background: rgba(13, 34, 36, 0.8);
		cursor: pointer;
		overflow: hidden;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.pricing-showcase__thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.pricing-showcase__thumb.is-active,
	.pricing-showcase__thumb:hover {
		border-color: rgba(24, 217, 210, 0.75);
		box-shadow: 0 0 20px rgba(24, 217, 210, 0.25);
	}

	.pricing-showcase__thumb-play {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		background: rgba(5, 11, 12, 0.35);
		color: white;
	}

	.pricing-showcase__checkout {
		display: flex;
		flex-direction: column;
		gap: 0.7rem;
		min-width: 0;
		justify-content: center;
	}

	.pricing-showcase__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.65rem;
	}

	.pricing-showcase__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2.8vw, 1.85rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.15;
		text-transform: uppercase;
	}

	.pricing-showcase__status {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		flex-shrink: 0;
		padding: 0.35rem 0.7rem;
		border-radius: 999px;
		border: 1px solid rgba(24, 217, 210, 0.35);
		background: rgba(24, 217, 210, 0.1);
		color: var(--color-mint);
		font-size: 0.68rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.pricing-showcase__status-dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 999px;
		background: var(--color-mint);
		box-shadow: 0 0 8px rgba(24, 217, 210, 0.65);
	}

	.pricing-showcase__social {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0;
		color: var(--color-mint);
		font-size: 0.8rem;
		font-weight: 600;
	}

	.pricing-showcase__social-dot {
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 999px;
		background: var(--color-mint);
	}

	.pricing-showcase__plans {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.6rem;
		align-items: stretch;
	}

	.pricing-showcase__plan {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: 0.2rem;
		width: 100%;
		min-height: 5.25rem;
		margin: 0;
		padding: 0.85rem 0.9rem;
		border-radius: 0.75rem;
		border: 1px solid rgba(24, 217, 210, 0.22);
		background: rgba(13, 34, 36, 0.85);
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: pointer;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease,
			background 0.2s ease;
	}

	.pricing-showcase__plan:hover {
		border-color: rgba(24, 217, 210, 0.45);
	}

	.pricing-showcase__plan.is-selected {
		border-color: rgba(24, 217, 210, 0.75);
		background: rgba(27, 78, 79, 0.18);
		box-shadow:
			0 0 0 1px rgba(24, 217, 210, 0.35) inset,
			0 0 24px rgba(24, 217, 210, 0.15);
	}

	.pricing-showcase__plan--featured {
		position: relative;
		padding-top: 1.55rem;
	}

	.pricing-showcase__plan-badge {
		position: absolute;
		top: 0.5rem;
		left: 50%;
		transform: translateX(-50%);
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.2rem 0.55rem;
		border-radius: 999px;
		background: rgba(43, 119, 120, 0.35);
		border: 1px solid rgba(24, 217, 210, 0.35);
		color: var(--color-orchid);
		font-size: 0.62rem;
		font-weight: 800;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.pricing-showcase__plan-main {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
		width: 100%;
	}

	.pricing-showcase__plan-name {
		font-size: 0.88rem;
		font-weight: 700;
		color: var(--color-ink);
		line-height: 1.2;
	}

	.pricing-showcase__plan.is-selected .pricing-showcase__plan-name {
		color: var(--color-orchid);
	}

	.pricing-showcase__plan-price {
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--color-ink);
		white-space: nowrap;
	}

	.pricing-showcase__plan-sub {
		font-size: 0.74rem;
		font-weight: 600;
		color: var(--color-faint);
		text-align: left;
	}

	.pricing-showcase__cart {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		width: 100%;
		margin: 0.1rem 0 0;
		padding: 0.9rem 1.1rem;
		border-radius: 0.75rem;
		font-size: 0.95rem;
		font-weight: 700;
		text-transform: none;
		box-shadow: 0 6px 18px rgba(43, 119, 120, 0.22);
	}

	.pricing-showcase__pills {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.4rem;
	}

	.pricing-showcase__pill {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: flex-start;
		gap: 0.45rem;
		min-height: auto;
		padding: 0.55rem 0.65rem;
		border-radius: 0.6rem;
		border: 1px solid rgba(24, 217, 210, 0.14);
		background: rgba(13, 34, 36, 0.75);
		color: var(--color-muted);
		font-size: 0.72rem;
		font-weight: 600;
		line-height: 1.25;
		text-align: left;
	}

	.pricing-showcase__pill-icon {
		display: grid;
		place-items: center;
		width: 1.35rem;
		height: 1.35rem;
		color: var(--color-orchid);
	}

	.pricing-showcase__pill-icon svg {
		width: 100%;
		height: 100%;
	}

	.pricing-showcase__guarantee {
		display: flex;
		align-items: flex-start;
		gap: 0.65rem;
		padding: 0.75rem 0.85rem;
		border-radius: 0.7rem;
		border: 1px solid rgba(24, 217, 210, 0.14);
		background: rgba(13, 34, 36, 0.55);
	}

	.pricing-showcase__guarantee-icon {
		flex-shrink: 0;
		display: grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 999px;
		background: rgba(24, 217, 210, 0.12);
