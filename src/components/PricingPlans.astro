---
import { getUi } from '../data/i18n';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { productInfo, siteConfig } from '../data/site';
import PlanSummaryPanels from './PlanSummaryPanels.astro';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);

const planCopy = {
	monthly: {
		note: ui.product.available,
		period: ui.product.monthly,
	},
	lifetime: {
		note: ui.product.available,
		period: ui.product.lifetime,
	},
} as const;

const defaultPlan = productInfo.plans.find((plan) => plan.id === 'monthly') ?? productInfo.plans[0];
---

<section
	class="plans"
	data-plan-selector
	data-default-plan={defaultPlan.id}
	data-buy-prefix={ui.common.buyNow}
	aria-label={ui.nav.pricing}
>
	<div class="plans__grid">
		{
			productInfo.plans.map((plan) => {
				const copy = planCopy[plan.id as keyof typeof planCopy] ?? planCopy.monthly;
				const featured = plan.id === 'lifetime';
				const selected = plan.id === defaultPlan.id;
				return (
					<button
						type="button"
						class:list={[
							'plans__card',
							featured && 'plans__card--featured',
							selected && 'is-selected',
						]}
						data-plan={plan.id}
						data-plan-label={copy.period}
						data-plan-price={plan.price}
						data-checkout-url={siteConfig.checkoutUrl}
						aria-pressed={selected}
					>
						{featured ? (
							<p class="plans__badge">{ui.product.lifetime}</p>
						) : (
							<span class="plans__badge plans__badge--spacer" aria-hidden="true">
								{ui.product.lifetime}
							</span>
						)}
						<p class="plans__name">{copy.period}</p>
						<p class="plans__price">
							<span class="plans__amount">${plan.price}</span>
							<span class="plans__period">{copy.note}</span>
						</p>
					</button>
				);
			})
		}
	</div>

	<PlanSummaryPanels defaultPlanId={defaultPlan.id} class="plans__summary" />

	<a
		href={siteConfig.checkoutUrl}
		class="plans__cta btn-buy"
		data-plan-buy
		rel="noopener noreferrer"
	>
		<span data-plan-buy-label>{ui.common.buyNow} — ${defaultPlan.price}</span>
	</a>
</section>

<script>
	import { initPlanSelectors } from '../lib/plan-selector';
	initPlanSelectors();
</script>

<style>
	.plans {
		display: grid;
		gap: 0.65rem;
		width: 100%;
		box-sizing: border-box;
	}

	.plans__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
		align-items: stretch;
		width: 100%;
	}

	.plans__summary {
		width: 100%;
	}

	.plans__cta {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		box-sizing: border-box;
		margin: 0;
	}

	.plans__card {
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		gap: 0.35rem;
		min-height: 7.5rem;
		width: 100%;
		margin: 0;
		padding: 1rem 1.15rem;
		border-radius: 0.9rem;
		border: 1px solid rgba(168, 85, 247, 0.16);
		background: rgba(22, 18, 32, 0.92);
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: pointer;
		box-sizing: border-box;
		transition:
			border-color 0.2s ease,
			box-shadow 0.2s ease;
	}

	.plans__card.is-selected {
		border-color: rgba(192, 132, 252, 0.55);
		box-shadow: inset 0 0 0 1px rgba(192, 132, 252, 0.35);
	}

	.plans__card--featured {
		border-color: rgba(192, 132, 252, 0.45);
		background:
			linear-gradient(180deg, rgba(88, 28, 135, 0.28), rgba(22, 18, 32, 0.94));
	}

	.plans__card--featured.is-selected {
		border-color: rgba(216, 180, 254, 0.65);
		box-shadow: inset 0 0 0 1px rgba(216, 180, 254, 0.4);
	}

	.plans__badge {
		margin: 0 0 0.15rem;
		align-self: flex-start;
		padding: 0.28rem 0.65rem;
		border-radius: 999px;
		border: 1px solid rgba(192, 132, 252, 0.35);
		background: rgba(124, 58, 237, 0.22);
		color: var(--color-orchid);
		font-size: 0.68rem;
		font-weight: 700;
		line-height: 1.2;
		letter-spacing: 0.1em;
		text-transform: uppercase;
	}

	.plans__badge--spacer {
		visibility: hidden;
		border-color: transparent;
		background: transparent;
	}

	.plans__name {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.1rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		color: var(--color-ink);
	}

	.plans__price {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.35rem 0.65rem;
		margin: 0;
		margin-top: auto;
	}

	.plans__amount {
		font-family: var(--font-display);
		font-size: clamp(1.85rem, 3.5vw, 2.35rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1;
		color: var(--color-ink);
	}

	.plans__period {
		font-size: 0.8rem;
		font-weight: 600;
		color: var(--color-muted);
	}

	@media (max-width: 640px) {
		.plans__grid {
			grid-template-columns: 1fr;
		}

		.plans__card {
			min-height: 0;
		}
	}
</style>
