---
import { getUi } from '../data/i18n';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const trust = getUi(locale).trust;

const items = [
	{
		key: 'status',
		label: 'Status',
		value: trust.status,
		live: true,
		icon: 'signal',
		href: getLocalizedPath('updates', locale),
	},
	{
		key: 'delivery',
		label: 'Delivery',
		value: trust.delivery,
		live: false,
		icon: 'bolt',
		href: getLocalizedPath('pricing', locale),
	},
	{
		key: 'platform',
		label: 'Platform',
		value: trust.platform,
		live: false,
		icon: 'monitor',
		href: getLocalizedPath('setup', locale),
	},
	{
		key: 'anticheat',
		label: 'Anti-cheat',
		value: trust.antiCheatShort,
		live: false,
		icon: 'shield',
		href: getLocalizedPath('undetected', locale),
	},
] as const;
---

<section class="trust-bar shell" aria-label="Warframe Cheats package status">
	<ul class="trust-bar__panel">
		{
			items.map((item) => (
				<li class:list={['trust-bar__cell', { 'trust-bar__cell--live': item.live }]}>
					<a class="trust-bar__link" href={item.href}>
						<span class="trust-bar__icon" aria-hidden="true" data-icon={item.icon}>
							{item.icon === 'signal' && (
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
									<path d="M4 18v-2M8 18V10M12 18V6M16 18v-5M20 18V8" stroke-linecap="round" />
								</svg>
							)}
							{item.icon === 'bolt' && (
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
									<path d="M13 3 5.5 13.5H12l-1 7.5L19.5 10H13l0-7Z" stroke-linejoin="round" />
								</svg>
							)}
							{item.icon === 'monitor' && (
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
									<rect x="3.5" y="4.5" width="17" height="12" rx="1.5" />
									<path d="M8 20h8M12 16.5V20" stroke-linecap="round" />
								</svg>
							)}
							{item.icon === 'shield' && (
								<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
									<path d="M12 3.5 5 6.5v5.2c0 4.2 2.9 7.8 7 8.8 4.1-1 7-4.6 7-8.8V6.5L12 3.5Z" stroke-linejoin="round" />
									<path d="m9.5 12 1.8 1.8 3.7-3.8" stroke-linecap="round" stroke-linejoin="round" />
								</svg>
							)}
						</span>
						<span class="trust-bar__copy">
							<span class="trust-bar__label">{item.label}</span>
							<span class="trust-bar__value">
								{item.live && <span class="trust-bar__dot" aria-hidden="true" />}
								{item.value}
							</span>
						</span>
					</a>
				</li>
			))
		}
	</ul>
</section>

<style>
	/* Mobile-first: compact 2×2 panel, readable at 360–430px */
	.trust-bar {
		padding-block: 0.55rem 0.85rem;
		content-visibility: auto;
		contain-intrinsic-size: 1px 168px;
	}

	.trust-bar__panel {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.35rem;
		margin: 0;
		padding: 0.4rem;
		list-style: none;
		border-radius: 1rem;
		border: 1px solid rgba(168, 85, 247, 0.24);
		background:
			linear-gradient(180deg, rgba(168, 85, 247, 0.08) 0%, rgba(26, 22, 38, 0.5) 48%, rgba(10, 6, 18, 0.72) 100%),
			rgba(18, 16, 26, 0.92);
		box-shadow:
			0 0 0 1px rgba(192, 132, 252, 0.04) inset,
			0 8px 22px rgba(0, 0, 0, 0.28);
	}

	.trust-bar__cell {
		min-width: 0;
		border-radius: 0.75rem;
		position: relative;
		background: rgba(168, 85, 247, 0.05);
		border: 1px solid rgba(168, 85, 247, 0.12);
	}

	.trust-bar__link {
		display: flex;
		align-items: flex-start;
		gap: 0.55rem;
		min-width: 0;
		min-height: var(--touch-min);
		padding: 0.7rem 0.65rem;
		color: inherit;
		text-decoration: none;
		transition:
			background 0.2s ease,
			border-color 0.2s ease;
	}

	.trust-bar__link:hover {
		background: rgba(168, 85, 247, 0.1);
	}

	.trust-bar__cell:not(:last-child)::after {
		display: none;
	}

	.trust-bar__icon {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 1.9rem;
		height: 1.9rem;
		margin-top: 0.05rem;
		border-radius: 0.55rem;
		color: var(--color-orchid);
		background: rgba(168, 85, 247, 0.14);
		border: 1px solid rgba(168, 85, 247, 0.22);
		box-shadow: none;
	}

	.trust-bar__icon svg {
		width: 1rem;
		height: 1rem;
	}

	.trust-bar__cell--live .trust-bar__icon {
		color: var(--color-mint);
		background: rgba(52, 211, 153, 0.14);
		border-color: rgba(52, 211, 153, 0.3);
		box-shadow: none;
	}

	.trust-bar__copy {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		min-width: 0;
		flex: 1;
	}

	.trust-bar__label {
		font-size: 0.6rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--color-faint);
		line-height: 1.2;
	}

	.trust-bar__value {
		display: inline-flex;
		align-items: flex-start;
		gap: 0.35rem;
		font-size: 0.78rem;
		font-weight: 650;
		line-height: 1.3;
		color: var(--color-ink);
		overflow-wrap: break-word;
		word-break: normal;
	}

	.trust-bar__cell--live .trust-bar__value {
		color: var(--color-mint);
	}

	.trust-bar__dot {
		width: 0.4rem;
		height: 0.4rem;
		margin-top: 0.28rem;
		border-radius: 999px;
		background: var(--color-mint);
		box-shadow: none;
		flex-shrink: 0;
	}

	@keyframes trust-rise {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes trust-pulse {
		0%,
		100% {
			box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.45);
			opacity: 1;
		}
		50% {
			box-shadow: 0 0 0 5px rgba(52, 211, 153, 0);
			opacity: 0.85;
		}
	}

	@media (max-width: 379px) {
		.trust-bar {
			contain-intrinsic-size: 1px 248px;
		}

		.trust-bar__panel {
			grid-template-columns: 1fr;
			gap: 0.3rem;
		}

		.trust-bar__link {
			align-items: center;
			padding: 0.75rem 0.8rem;
		}

		.trust-bar__icon {
			margin-top: 0;
		}

		.trust-bar__value {
			font-size: 0.82rem;
			overflow-wrap: break-word;
			word-break: normal;
		}

		.trust-bar__dot {
			margin-top: 0.35rem;
		}
	}

	@media (min-width: 380px) and (max-width: 900px) {
		.trust-bar__link {
			padding: 0.75rem 0.8rem;
			gap: 0.65rem;
		}

		.trust-bar__value {
			font-size: 0.82rem;
		}
	}

	@media (min-width: 901px) {
		.trust-bar {
			padding-block: 0.65rem 0.9rem;
			contain-intrinsic-size: 1px 88px;
		}

		.trust-bar__panel {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 0;
			padding: 0.35rem;
			border-radius: 1.15rem;
			border-color: rgba(168, 85, 247, 0.28);
			background:
				linear-gradient(180deg, rgba(168, 85, 247, 0.1) 0%, rgba(26, 22, 38, 0.55) 42%, rgba(10, 6, 18, 0.72) 100%),
				rgba(18, 16, 26, 0.88);
			box-shadow:
				0 0 0 1px rgba(192, 132, 252, 0.06) inset,
				0 12px 36px rgba(0, 0, 0, 0.32),
				0 0 42px rgba(168, 85, 247, 0.12);
		}

		.trust-bar__cell {
			background: transparent;
			border: 0;
			border-radius: 0.9rem;
		}

		.trust-bar__link {
			align-items: center;
			gap: 0.7rem;
			padding: 0.75rem 0.85rem;
			min-height: 0;
		}

		.trust-bar__cell:not(:last-child)::after {
			display: block;
			content: '';
			position: absolute;
			top: 18%;
			right: 0;
			width: 1px;
			height: 64%;
			background: linear-gradient(
				180deg,
				transparent 0%,
				rgba(168, 85, 247, 0.35) 50%,
				transparent 100%
			);
		}

		.trust-bar__icon {
			width: 2.15rem;
			height: 2.15rem;
			margin-top: 0;
			border-radius: 0.7rem;
			background: linear-gradient(160deg, rgba(168, 85, 247, 0.22), rgba(124, 58, 237, 0.08));
			border-color: rgba(168, 85, 247, 0.28);
			box-shadow: 0 0 18px rgba(168, 85, 247, 0.12);
		}

		.trust-bar__icon svg {
			width: 1.1rem;
			height: 1.1rem;
		}

		.trust-bar__cell--live .trust-bar__icon {
			background: linear-gradient(160deg, rgba(52, 211, 153, 0.2), rgba(168, 85, 247, 0.08));
			border-color: rgba(52, 211, 153, 0.35);
			box-shadow: 0 0 18px rgba(52, 211, 153, 0.14);
		}

		.trust-bar__label {
			font-size: 0.62rem;
			letter-spacing: 0.12em;
		}

		.trust-bar__value {
			align-items: center;
			gap: 0.4rem;
			font-size: 0.86rem;
			line-height: 1.25;
			overflow-wrap: normal;
			word-break: normal;
			hyphens: none;
		}

		.trust-bar__dot {
			width: 0.45rem;
			height: 0.45rem;
			margin-top: 0;
			box-shadow: 0 0 0 0 rgba(52, 211, 153, 0.5);
		}
	}

	@media (min-width: 901px) and (prefers-reduced-motion: no-preference) {
		.trust-bar__panel {
			animation: trust-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) 0.05s both;
		}

		.trust-bar__dot {
			animation: trust-pulse 2.2s ease-in-out infinite;
		}
	}
</style>
