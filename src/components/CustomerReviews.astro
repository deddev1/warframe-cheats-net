---
import { getUi } from '../data/i18n';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';
import { customerReviewStats, customerReviews, customerStats } from '../data/site';
import { reviewsBasePath } from '../data/reviews';

interface Props {
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const ui = getUi(locale);
const reviewsUi = ui.reviews;
const featuredReviews = customerReviews.slice(0, 4);

const reviewDateFormatter = new Intl.DateTimeFormat(locale, {
	month: 'short',
	day: 'numeric',
	year: 'numeric',
	timeZone: 'UTC',
});

function formatReviewDate(isoDate: string): string {
	return reviewDateFormatter.format(new Date(`${isoDate}T00:00:00Z`));
}

const seeAllLabel = (reviewsUi.seeAll ?? 'See all {count} reviews').replace(
	'{count}',
	customerReviewStats.displayCount,
);
const verifiedLabel = reviewsUi.verifiedLabel ?? 'Verified customer';
---

<section class="reviews shell" aria-labelledby="reviews-title">
	<header class="reviews__header">
		<div class="reviews__intro">
			<h2 id="reviews-title" class="reviews__title">
				<span class="reviews__accent" aria-hidden="true"></span>
				{reviewsUi.title}
			</h2>
			<p class="reviews__subtitle">
				<span class="reviews__live-dot" aria-hidden="true"></span>
				{reviewsUi.subtitle}
			</p>
		</div>
		<a class="reviews__see-all" href={reviewsBasePath}>
			{seeAllLabel}
			<svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
				<path
					d="M5 12h14m-6-6l6 6-6 6"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</a>
	</header>

	<div class="reviews__grid">
		{
			featuredReviews.map((review) => (
				<article class="reviews__card">
					<div class="reviews__card-top">
						<div class="reviews__who">
							<span class="reviews__avatar" aria-hidden="true">
								{review.handle.charAt(0).toUpperCase()}
							</span>
							<div class="reviews__meta">
								<p class="reviews__handle">{review.handle}</p>
								<p class="reviews__verified">
									<svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
										<path
											d="m9.5 12 1.8 1.8 3.7-3.8M12 3.5 5 6.5v5.2c0 4.2 2.9 7.8 7 8.8 4.1-1 7-4.6 7-8.8V6.5L12 3.5Z"
											stroke="currentColor"
											stroke-width="1.6"
											stroke-linecap="round"
											stroke-linejoin="round"></path>
									</svg>
									{verifiedLabel}
								</p>
							</div>
						</div>
						<p class="reviews__date">
							<time datetime={review.date}>{formatReviewDate(review.date)}</time>
						</p>
					</div>
					<div class="reviews__stars" aria-label={`${review.rating} out of 5 stars`}>
						{
							Array.from({ length: 5 }).map(() => (
								<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path d="M12 2.5l2.6 5.9 6.4.6-4.8 4.2 1.4 6.3L12 17.2 6.4 19.5l1.4-6.3L3 9l6.4-.6L12 2.5Z" />
								</svg>
							))
						}
					</div>
					<h3 class="reviews__headline">{review.title}</h3>
					<p class="reviews__text">{review.short}</p>
				</article>
			))
		}
	</div>

	<div class="reviews__stats" aria-label="Customer satisfaction statistics">
		{
			customerStats.map((stat) => (
				<article class="reviews__stat">
					<p class="reviews__stat-value">{stat.value}</p>
					<p class="reviews__stat-label">{stat.label}</p>
				</article>
			))
		}
	</div>
</section>

<style>
	.reviews {
		padding-block: var(--section-space);
	}

	.reviews__header {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem 1.5rem;
		margin-bottom: 1.35rem;
	}

	.reviews__intro {
		display: grid;
		gap: 0.5rem;
	}

	.reviews__title {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2.5vw, 1.75rem);
		font-weight: 800;
	}

	.reviews__accent {
		display: inline-block;
		width: 0.22rem;
		height: 1.35rem;
		border-radius: 999px;
		background: linear-gradient(180deg, #e879f9, #a855f7);
		flex-shrink: 0;
	}

	.reviews__subtitle {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		margin: 0;
		color: var(--color-muted);
		font-size: 0.9rem;
		line-height: 1.55;
	}

	.reviews__live-dot {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 999px;
		background: #34d399;
		box-shadow: 0 0 0.35rem rgba(52, 211, 153, 0.65);
		flex-shrink: 0;
	}

	.reviews__see-all {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.65rem 1rem;
		border-radius: 0.75rem;
		border: 1px solid rgba(168, 85, 247, 0.28);
		background: rgba(18, 16, 26, 0.85);
		color: var(--color-ink);
		font-size: 0.86rem;
		font-weight: 700;
		white-space: nowrap;
		transition:
			border-color 0.2s ease,
			background 0.2s ease;
	}

	.reviews__see-all:hover {
		border-color: rgba(192, 132, 252, 0.5);
		background: rgba(48, 36, 72, 0.85);
		color: var(--color-ink);
	}

	.reviews__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.85rem;
	}

	.reviews__card {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		padding: 1.05rem 1.1rem;
		border-radius: 0.95rem;
		border: 1px solid rgba(45, 212, 191, 0.35);
		background: rgba(20, 24, 30, 0.88);
		transition:
			border-color 0.2s ease,
			transform 0.2s ease,
			box-shadow 0.2s ease;
	}

	.reviews__card:hover {
		border-color: rgba(45, 212, 191, 0.55);
		transform: translateY(-2px);
		box-shadow: 0 10px 24px rgba(0, 0, 0, 0.25);
	}

	.reviews__card-top {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.reviews__who {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		min-width: 0;
	}

	.reviews__avatar {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex: 0 0 auto;
		width: 2.15rem;
		height: 2.15rem;
		border-radius: 999px;
		border: 1px solid rgba(45, 212, 191, 0.35);
		background: rgba(15, 23, 42, 0.85);
		color: #5eead4;
		font-size: 0.9rem;
		font-weight: 800;
	}

	.reviews__meta {
		min-width: 0;
	}

	.reviews__handle {
		margin: 0;
		font-size: 0.88rem;
		font-weight: 700;
		color: var(--color-ink);
		overflow-wrap: anywhere;
	}

	.reviews__verified {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		margin: 0.12rem 0 0;
		font-size: 0.68rem;
		font-weight: 700;
		color: #34d399;
	}

	.reviews__date {
		margin: 0;
		font-size: 0.72rem;
		color: var(--color-faint);
		white-space: nowrap;
	}

	.reviews__stars {
		display: flex;
		align-items: center;
		gap: 0.12rem;
		color: #34d399;
	}

	.reviews__headline {
		margin: 0;
		font-size: 0.95rem;
		font-weight: 800;
		line-height: 1.35;
		color: var(--color-ink);
	}

	.reviews__text {
		margin: 0;
		color: #b8c0cc;
		font-size: 0.88rem;
		line-height: 1.6;
	}

	.reviews__stats {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.85rem;
		margin-top: 1.1rem;
	}

	.reviews__stat {
		position: relative;
		padding: 1.35rem 1.1rem 1.15rem;
		border-radius: 0.95rem;
		border: 1px solid rgba(168, 85, 247, 0.14);
		background: rgba(20, 24, 30, 0.88);
		text-align: center;
		overflow: hidden;
	}

	.reviews__stat::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		height: 2px;
		background: linear-gradient(90deg, transparent, #e879f9, #a855f7, transparent);
	}

	.reviews__stat-value {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(2rem, 4vw, 2.65rem);
		font-weight: 800;
		line-height: 1;
		color: var(--color-ink);
	}

	.reviews__stat-label {
		margin: 0.55rem 0 0;
		color: var(--color-muted);
		font-size: 0.88rem;
		line-height: 1.45;
	}

	@media (max-width: 900px) {
		.reviews__stats {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 680px) {
		.reviews__grid {
			grid-template-columns: 1fr;
		}

		.reviews__see-all {
			width: 100%;
			justify-content: center;
			min-height: var(--touch-min);
		}

		.reviews__header {
			flex-direction: column;
		}
	}
</style>
