---
import PageLayout from '../layouts/PageLayout.astro';
import { getPageContent, getUi, type PageId } from '../data/i18n';
import { getCanonicalPath, getLocalizedPath, localizeInternalHref } from '../data/i18n/routing';
import type { LocaleCode } from '../data/i18n/locales';
import { defaultLocale } from '../data/i18n/locales';
import { seoFaqs, siteConfig } from '../data/site';
import { warframeImages } from '../data/warframe';
import { buildPageExtraGraph, pageFaqClusters } from '../data/schema';
import SeoFaqPanel from '../components/SeoFaqPanel.astro';
import RelatedPages from '../components/RelatedPages.astro';
import PricingPlans from '../components/PricingPlans.astro';
import PricingFeatureList from '../components/PricingFeatureList.astro';
import FeaturesDetail from '../components/FeaturesDetail.astro';
import { getPageRelatedLinks } from '../lib/internal-links';

interface Props {
	locale: LocaleCode;
	pageId: PageId;
}

const { locale, pageId } = Astro.props;
const page = getPageContent(locale, pageId);
const ui = getUi(locale);
const relatedLinks = getPageRelatedLinks(pageId, locale, {
	esp: ui.nav.esp,
	aimbot: ui.nav.aimbot,
	features: ui.nav.features,
	setup: ui.nav.setup,
	pricing: ui.nav.pricing,
	updates: ui.nav.updates,
	faq: ui.nav.faq,
});

function localizeParagraphHtml(html: string): string {
	return html
		.replace(/\{checkout\}/g, siteConfig.checkoutUrl)
		.replace(/href="(\/[^"]+)"/g, (_, path: string) => `href="${localizeInternalHref(path, locale)}"`);
}

const galleryPool = [
	warframeImages.product[0],
	warframeImages.product[1],
	warframeImages.product[2],
];

const canonicalPath = getCanonicalPath(pageId, locale);
const canonicalURL = new URL(canonicalPath, siteConfig.url).href;
const heroImageUrl = new URL(page.heroImage ?? warframeImages.hero, siteConfig.url).href;

const extraGraph =
	locale === defaultLocale
		? buildPageExtraGraph(pageId, canonicalURL, heroImageUrl, seoFaqs)
		: [];

const ctaSecondaryHref = page.ctaSecondaryHref
	? localizeInternalHref(page.ctaSecondaryHref, locale)
	: page.ctaSecondary
		? siteConfig.checkoutUrl
		: getLocalizedPath('features', locale);
---

<PageLayout
	title={page.title}
	description={page.description}
	canonicalPath={canonicalPath}
	heading={page.h1}
	intro={page.intro}
	heroImage={page.heroImage}
	heroAlt={page.imageAlt}
	gallery={galleryPool.map((img) => ({
		src: typeof img === 'string' ? img : img.src,
		alt: typeof img === 'string' ? page.imageAlt : img.alt,
	}))}
	galleryTitle={page.galleryTitle}
	locale={locale}
	pageId={pageId}
	showGallery={pageId !== 'pricing' && pageId !== 'features'}
	hideBanner={pageId === 'pricing' || pageId === 'features'}
	extraGraph={extraGraph}
	contentWidth={pageId === 'pricing' || pageId === 'features' ? 'full' : 'narrow'}
	ctaPrimary={{ href: siteConfig.checkoutUrl, label: page.ctaPrimary }}
	ctaSecondary={
		page.ctaSecondary
			? { href: ctaSecondaryHref, label: page.ctaSecondary }
			: undefined
	}
>
	{pageId === 'pricing' && <PricingPlans locale={locale} />}
	{pageId === 'pricing' && <PricingFeatureList locale={locale} showRelatedPages={false} />}
	{pageId === 'features' && (
		<header class="features-page-head">
			<nav class="features-page-head__crumbs" aria-label="Breadcrumb">
				<a href={getLocalizedPath('home', locale)}>{ui.nav.home}</a>
				<span aria-hidden="true">/</span>
				<span aria-current="page">{ui.nav.features}</span>
			</nav>
			<h1 class="features-page-head__title">{page.h1}</h1>
			<p class="features-page-head__intro">{page.intro}</p>
			<div class="features-page-head__actions">
				<a href={siteConfig.checkoutUrl} class="btn-buy" rel="noopener noreferrer">
					{page.ctaPrimary}
				</a>
				{
					page.ctaSecondary && (
						<a href={ctaSecondaryHref} class="btn btn--ghost">
							{page.ctaSecondary}
						</a>
					)
				}
			</div>
		</header>
	)}
	{pageId === 'features' && <FeaturesDetail locale={locale} />}
	{
		!(pageId === 'pricing' || pageId === 'features') &&
		page.sections.map((section) => (
			<section class="card-panel">
				<h2>{section.h2}</h2>
				{section.paragraphs.map((p) => (
					<p set:html={localizeParagraphHtml(p)} />
				))}
				{section.list && (
					<ul>
						{section.list.map((item) => (
							<li set:html={item} />
						))}
					</ul>
				)}
			</section>
		))
	}
	{
		locale === defaultLocale && pageId === 'faq' && (
			<SeoFaqPanel items={seoFaqs} title="All questions" />
		)
	}
	{
		locale === defaultLocale && pageId !== 'faq' && pageFaqClusters[pageId] && (
			<SeoFaqPanel items={pageFaqClusters[pageId]!} />
		)
	}
	<RelatedPages locale={locale} links={relatedLinks} />
</PageLayout>

<style>
	.features-page-head {
		display: grid;
		gap: 0.85rem;
		max-width: 42rem;
		margin: 0 auto 2rem;
		padding: 0 0 0.25rem;
		text-align: center;
	}

	.features-page-head__crumbs {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		flex-wrap: wrap;
		gap: 0.45rem;
		font-size: 0.8rem;
		color: var(--color-faint);
	}

	.features-page-head__crumbs a {
		color: var(--color-muted);
		font-weight: 600;
	}

	.features-page-head__crumbs a:hover {
		color: var(--color-orchid);
	}

	.features-page-head__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.75rem, 3.8vw, 2.35rem);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.12;
		color: var(--color-ink);
	}

	.features-page-head__intro {
		margin: 0;
		color: var(--color-muted);
		font-size: 1rem;
		line-height: 1.65;
	}

	.features-page-head__actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.65rem;
		margin-top: 0.35rem;
	}

	.features-page-head__actions .btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.7rem;
		padding: 0.7rem 1.15rem;
		border-radius: 0.75rem;
		font-size: 0.92rem;
		font-weight: 700;
	}

	.features-page-head__actions .btn--ghost {
		border: 1px solid var(--color-border);
		background: rgba(13, 35, 36, 0.7);
		color: var(--color-ink);
	}

	.features-page-head__actions .btn--ghost:hover {
		border-color: rgba(32, 191, 192, 0.45);
		color: var(--color-ink);
	}

	@media (max-width: 640px) {
		.features-page-head__actions {
			flex-direction: column;
			align-items: stretch;
		}

		.features-page-head__actions .btn-buy,
		.features-page-head__actions .btn {
			width: 100%;
		}
	}
</style>
