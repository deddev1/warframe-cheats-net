---
import { homeFaqs } from '../data/site';
import { getLocalizedPath } from '../data/i18n/routing';
import { defaultLocale, type LocaleCode } from '../data/i18n/locales';

interface Props {
	title?: string;
	locale?: LocaleCode;
}

const locale = Astro.props.locale ?? defaultLocale;
const { title = 'FAQ' } = Astro.props;
const faqHref = getLocalizedPath('faq', locale);
---

<section class="home-faq shell" aria-labelledby="home-faq-title">
	<h2 id="home-faq-title" class="home-faq__title">
		<span class="home-faq__accent" aria-hidden="true"></span>
		{title}
	</h2>

	<div class="home-faq__list">
		{
			homeFaqs.map((item) => (
				<details class="home-faq__item">
					<summary>{item.question}</summary>
					<p set:html={item.answer} />
				</details>
			))
		}
	</div>

	<p class="home-faq__more">
		<a href={faqHref}>See all FAQ questions</a>
	</p>
</section>

<style>
	.home-faq {
		padding-block: 0;
	}

	.home-faq__title {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		margin: 0 0 1.1rem;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2.5vw, 1.75rem);
		font-weight: 800;
	}

	.home-faq__accent {
		display: inline-block;
		width: 0.22rem;
		height: 1.35rem;
		border-radius: 999px;
		background: linear-gradient(180deg, #e879f9, #a855f7);
		flex-shrink: 0;
	}

	.home-faq__list {
		display: grid;
		gap: 0;
		border-radius: 0.95rem;
		border: 1px solid rgba(168, 85, 247, 0.14);
		background: rgba(20, 24, 30, 0.88);
		overflow: hidden;
	}

	.home-faq__item {
		border-top: 1px solid rgba(168, 85, 247, 0.12);
		padding: 0.85rem 1.1rem;
	}

	.home-faq__item:first-child {
		border-top: none;
	}

	.home-faq__item summary {
		cursor: pointer;
		font-weight: 700;
		color: var(--color-ink);
		line-height: 1.45;
		list-style: none;
	}

	.home-faq__item summary::-webkit-details-marker {
		display: none;
	}

	.home-faq__item summary::after {
		content: '+';
		float: right;
		color: var(--color-orchid);
		font-weight: 800;
	}

	.home-faq__item[open] summary::after {
		content: '−';
	}

	.home-faq__item p {
		margin: 0.65rem 0 0;
		color: var(--color-muted);
		line-height: 1.65;
		font-size: 0.92rem;
	}

	.home-faq__item :global(a) {
		color: var(--color-orchid);
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.home-faq__more {
		margin: 0.85rem 0 0;
	}

	.home-faq__more a {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--color-orchid);
		font-size: 0.9rem;
		font-weight: 700;
	}
</style>
