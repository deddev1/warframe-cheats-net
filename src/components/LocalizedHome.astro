---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import BreadcrumbBar from '../components/BreadcrumbBar.astro';
import PricingPlans from '../components/PricingPlans.astro';
import PricingFeatureList from '../components/PricingFeatureList.astro';
import Gallery from '../components/Gallery.astro';
import HomeSeo from '../components/HomeSeo.astro';
import CustomerReviews from '../components/CustomerReviews.astro';
import TrustBar from '../components/TrustBar.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { getLocaleContent, getPageContent } from '../data/i18n';
import { getCanonicalPath, getLocalizedPath } from '../data/i18n/routing';
import type { LocaleCode } from '../data/i18n/locales';
import { defaultLocale } from '../data/i18n/locales';
import { homeFaqs, productInfo, siteConfig, customerReviewStats, customerReviews } from '../data/site';
import { warframeImages } from '../data/warframe';
import {
	buildAggregateOffer,
	buildFaqSchemaNode,
	buildSoftwareApplicationSchema,
} from '../data/schema';
import { heroPreloadSrc, heroSizes, heroSrcSet } from '../lib/responsive-images';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const { ui } = getLocaleContent(locale);
const home = getPageContent(locale, 'home');

const title = home.title;
const description = home.description;
/** SEO consolidates to English; locale routes remain for UX. */
const canonicalPath = getCanonicalPath('home', locale);
const canonicalURL = new URL(canonicalPath, siteConfig.url).href;
const heroImage = new URL(warframeImages.hero, siteConfig.url).href;

const extraGraph: Record<string, unknown>[] =
	locale === defaultLocale
		? [
	{
		'@type': 'Product',
		'@id': `${canonicalURL}#product`,
		name: productInfo.name,
		description: productInfo.summary,
		image: heroImage,
		brand: { '@type': 'Brand', name: productInfo.brand },
		url: canonicalURL,
		offers: buildAggregateOffer(canonicalURL),
		aggregateRating: {
			'@type': 'AggregateRating',
			ratingValue: customerReviewStats.averageRating.toFixed(1),
			reviewCount: customerReviewStats.totalCount,
			bestRating: '5',
			worstRating: '1',
		},
		review: customerReviews.map((review) => ({
			'@type': 'Review',
			author: { '@type': 'Person', name: review.handle },
			datePublished: review.date,
			reviewRating: {
				'@type': 'Rating',
				ratingValue: String(review.rating),
				bestRating: '5',
				worstRating: '1',
			},
			reviewBody: review.text,
		})),
	},
	buildSoftwareApplicationSchema(canonicalURL, heroImage),
	buildFaqSchemaNode(canonicalURL, homeFaqs),
]
		: [];
---

<Layout
	title={title}
	description={description}
	canonicalPath={canonicalPath}
	ogImage={siteConfig.defaultOgImage}
	ogImageAlt={home.imageAlt}
	locale={locale}
	pageId="home"
	breadcrumbs={[{ label: ui.nav.home }]}
	extraGraph={extraGraph}
	lcpImage={heroPreloadSrc}
	lcpImageSrcSet={heroSrcSet}
	lcpImageSizes={heroSizes}
>
	<Navbar locale={locale} pageId="home" />
	<main class="site">
		<Hero
			locale={locale}
			heading={home.h1}
			accent={ui.hero.accent}
			subtitle={ui.hero.subtitle}
			subtitleShort={ui.hero.subtitleShort}
		/>
		<section class="site__section site__section--trust">
			<TrustBar locale={locale} />
		</section>
		<BreadcrumbBar
			locale={locale}
			items={[
				{ label: ui.nav.home, href: getLocalizedPath('home', locale) },
				{ label: ui.product.title },
			]}
		/>
		<section class="site__section site__section--store" id="store" aria-label={ui.product.title}>
			<div class="shell store-stack">
				<PricingPlans locale={locale} />
				<PricingFeatureList locale={locale} />
			</div>
		</section>
		<section class="site__section site__section--seo">
			{
				locale === 'en' ? (
					<HomeSeo />
				) : (
					<div class="shell home-seo-intro">
						<h2>{home.h1}</h2>
						<p>{home.intro}</p>
						{
							home.sections.map((section) => (
								<div class="home-seo-block">
									<h3>{section.h2}</h3>
									{section.paragraphs.map((p) => (
										<p set:html={p} />
									))}
								</div>
							))
						}
					</div>
				)
			}
		</section>
		<section class="site__section site__section--gallery">
			<div class="shell">
				<Gallery locale={locale} />
			</div>
		</section>
		<section class="site__section site__section--reviews">
			<CustomerReviews locale={locale} />
		</section>
		<SiteFooter locale={locale} />
	</main>
</Layout>

<style>
	.site {
		overflow-x: clip;
	}

	.site__section--reviews {
		padding-top: 0.25rem;
		padding-bottom: 1.25rem;
		content-visibility: auto;
		contain-intrinsic-size: 1px 640px;
	}

	.site__section--trust {
		padding-block: 0.35rem 0.15rem;
		content-visibility: auto;
		contain-intrinsic-size: 1px 120px;
	}

	.site__section--store,
	.site__section--reviews,
	.site__section--seo,
	.site__section--gallery {
		content-visibility: auto;
		contain-intrinsic-size: 1px 720px;
	}

	@media (max-width: 760px) {
		.site__section--store {
			contain-intrinsic-size: 1px 900px;
		}
	}

	.site__section {
		padding-block: var(--section-space);
	}

	.store-stack {
		display: grid;
		gap: 1.25rem;
	}

	.site__section--seo {
		padding-top: 0.15rem;
	}

	.site__section--gallery {
		padding-top: 0.35rem;
		padding-bottom: 1.25rem;
	}

	.home-seo-intro {
		display: grid;
		gap: 1rem;
	}

	.home-seo-intro h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 3vw, 1.75rem);
		font-weight: 800;
	}

	.home-seo-intro p {
		margin: 0;
		color: var(--color-muted);
		line-height: 1.65;
	}

	.home-seo-block {
		padding: 1rem 1.1rem;
		border-radius: 0.9rem;
		border: 1px solid rgba(168, 85, 247, 0.14);
		background: rgba(26, 22, 38, 0.72);
		display: grid;
		gap: 0.65rem;
	}

	.home-seo-block h3 {
		margin: 0;
		font-size: 1rem;
		font-weight: 750;
	}

	@media (max-width: 768px) {
		.site__section--gallery {
			padding-bottom: 1rem;
		}
	}
</style>
